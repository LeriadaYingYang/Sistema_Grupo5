from director.utilidades import imprimir_titulo, imprimir_menu
from profesor.ver_cursos import ver_cursos_profesor
from profesor.ver_alumnos import ver_alumnos_inscritos
from profesor.registrar_notas import registrar_notas_profesor
from profesor.ver_horarios import ver_horarios_profesor


def menu_profesor(profesor):  # muestra el menú principal del módulo de profesor
    while True:
        imprimir_titulo("MENÚ PROFESOR")
        print(f"Sesión: Prof. {profesor['nombres']} {profesor['apellidos']}\n")
        imprimir_menu([
            "Ver mis cursos",
            "Ver alumnos inscritos",
            "Registrar notas",
            "Ver horarios",
            "Cerrar sesión"
        ])

        opcion = input("\nSeleccione una opción: ")

        if opcion == "1":
            ver_cursos_profesor(profesor)
        elif opcion == "2":
            ver_alumnos_inscritos(profesor)
        elif opcion == "3":
            registrar_notas_profesor(profesor)
        elif opcion == "4":
            ver_horarios_profesor(profesor)
        elif opcion == "5":
            print("\nCerrando sesión del profesor...")
            break
        else:
            print("\nOpción inválida. Intente nuevamente.")